<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.lebastudios.theroundtable.components.BigDecimalField?>
<HBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.lebastudios.theroundtableplugins.cr.cash.CollectOrderStageController"
      spacing="10">
    <VBox HBox.hgrow="ALWAYS" spacing="10" alignment="CENTER">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
        <Label fx:id="orderDateTimeLabel" />
        <Label fx:id="orderTotalLabel" style="-fx-font-size: 24; -fx-font-weight: bold" />
        <HBox alignment="CENTER" spacing="5">
            <RadioButton fx:id="cashRadioButton" mnemonicParsing="false" selected="true" text="%cr:word.cash"/>
            <RadioButton fx:id="cardRadioButton" mnemonicParsing="false" text="%cr:word.card"/>
        </HBox>
        <HBox fx:id="amountPaidBox" alignment="CENTER" spacing="15">
            <Label text="%cr:phrase.amountpaid"/>
            <BigDecimalField fx:id="amountPaidField" prefWidth="100" labelValue="€"/>
        </HBox>

        <CheckBox fx:id="defineClientOption" alignment="CENTER" maxWidth="Infinity" text="%cr:phrase.defineclient"/>

        <GridPane disable="true" fx:id="clientDataContainer" hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints/>
                <RowConstraints/>
            </rowConstraints>

            <Label text="%cr:phrase.clientname" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="clientNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="%cr:phrase.clientidentifier" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="clientIdentifierField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="5">
            <Button textAlignment="CENTER" onAction="#submitAndPrint" text="%cr:word.submitandprint"/>
            <Button defaultButton="true" textAlignment="CENTER" onAction="#submit" text="%cr:word.submit"/>
        </HBox>
    </VBox>
    <StackPane HBox.hgrow="ALWAYS" fx:id="receiptReportContainer">
        
    </StackPane>
</HBox>
